}
/* Panel Historial - Fin */

/* Panel Datos */
#PnlData
{
    background-color: #ffffff;
}

.MapTable
{
    background-color: #3a6ea5;
    color: #ffffff;
    border-collapse: collapse;
    border-width: 0px;
}

.MapTable tr
{
    height: 18px;
}

.MapTable td
{
    border: solid 1px #dddddd;
    text-align: center;
    font-weight: bold;
}

.Data
{    
